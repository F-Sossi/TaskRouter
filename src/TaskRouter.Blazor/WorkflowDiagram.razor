@using TaskRouter.Core.Builder
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    The workflow as a picture. The task list is authoritative and editable; this is for
    reading — seeing that a rework route really does go backwards, or that a task is
    stranded, is much faster here than in a list of routes.
*@

<MudPaper Class="pa-3" Elevation="1">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.h6">Diagram</MudText>
        <MudSpacer />
        <MudTooltip Text="Mermaid source">
            <MudIconButton Icon="@Icons.Material.Filled.Code" Size="Size.Small"
                           Color="@(_showSource ? Color.Primary : Color.Default)"
                           OnClick="@(() => _showSource = !_showSource)" />
        </MudTooltip>
        <MudIconButton Size="Size.Small"
                       Icon="@(_collapsed ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                       OnClick="Toggle" />
    </MudStack>

    <MudCollapse Expanded="@(!_collapsed)">
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                The diagram could not be drawn: @_error
            </MudAlert>
        }

        @* Horizontal scroll rather than a squashed graph: a long review chain is wide. *@
        <div @ref="_host" style="overflow-x:auto;" class="mt-2"></div>

        @if (_showSource)
        {
            <MudTextField T="string" Value="@_source" Label="Mermaid source" ReadOnly="true"
                          Lines="12" Variant="Variant.Outlined" Class="mt-2" />
        }
    </MudCollapse>
</MudPaper>

@code {
    /// <summary>The workflow to draw. Redrawn whenever <see cref="Revision"/> changes.</summary>
    [Parameter] public WorkflowEditModel? Model { get; set; }

    /// <summary>
    /// Bumped by the builder after any edit. The model is mutated in place rather than
    /// replaced, so comparing the parameter itself would never detect a change.
    /// </summary>
    [Parameter] public int Revision { get; set; }

    [Parameter] public bool Dark { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private string _source = string.Empty;
    private string? _error;
    private bool _collapsed;
    private bool _showSource;
    private int _drawn = -1;
    private int _sequence;

    protected override void OnParametersSet()
    {
        if (Model is not null)
        {
            _source = WorkflowMermaid.ToFlowchart(Model);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Model is null || _collapsed || Revision == _drawn)
        {
            return;
        }

        _drawn = Revision;
        await DrawAsync();
    }

    private async Task DrawAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/TaskRouter.Blazor/js/workflowDiagram.js");

            // Mermaid uses the id for the element it renders into, so it has to differ
            // on every draw or a re-render collides with the previous one.
            var id = $"wf-diagram-{++_sequence}";

            var error = await _module.InvokeAsync<string?>("render", _host, id, _source, Dark);

            if (error != _error)
            {
                _error = error;
                StateHasChanged();
            }
        }
        catch (JSException ex)
        {
            _error = ex.Message;
            StateHasChanged();
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away mid-draw. Nothing to report to.
        }
    }

    private async Task Toggle()
    {
        _collapsed = !_collapsed;

        if (!_collapsed)
        {
            _drawn = -1;   // force a redraw; the element was not in the DOM to draw into
            await Task.CompletedTask;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Disposing a module on a circuit that has already gone is not an error.
        }
    }
}
